    layout {
        gaps 10 // Gap between windows
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
    }

        struts {
    }
    focus-ring {
        width 2
        active-color "#89B4FA"
        inactive-color "#1D3159"
    }
    border {

        width 4
    }
    shadow {

        on
    }
}
